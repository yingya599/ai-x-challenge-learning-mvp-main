# NSEAP environment template
# Copy this file to .env.local and fill values locally. Never commit .env.local.

# Feishu application
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_TOKEN=

# Feishu Bitable tables
FEISHU_STUDENTS_TABLE_ID=
FEISHU_TEACHERS_TABLE_ID=
FEISHU_ADMINS_TABLE_ID=
FEISHU_CHALLENGES_TABLE_ID=
FEISHU_SUBMISSIONS_TABLE_ID=
FEISHU_EVALUATIONS_TABLE_ID=
FEISHU_PORTFOLIO_TABLE_ID=
FEISHU_AUDITLOGS_TABLE_ID=
FEISHU_INBOX_TABLE_ID=
FEISHU_SYSTEM_CONFIG_TABLE_ID=
FEISHU_TASKS_TABLE_ID=

# Feishu notifications
FEISHU_CLASS_CHAT_ID=

# Authentication
SESSION_SECRET=
COOKIE_SECURE=false
TEACHER_IDS=
ADMIN_CONFIG_MASTER_KEY=
ADMIN_BOOTSTRAP_TOKEN=

# Redis
REDIS_URL=redis://127.0.0.1:6379
# Local demo only. Formal environments must keep Redis-backed final-review locking.
REVIEW_LOCK_MODE=redis

# GitHub
GITHUB_TOKEN=

# AI provider
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
AI_REVIEW_MODEL=deepseek-v4-pro
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional remote course content
PLATFORM_CONTENT_URL=

# Explicit local demo fallback. Keep false in formal environments.
NEXT_PUBLIC_ENABLE_PORTFOLIO_MOCK=false

# Optional agent API keys. Example format:
# AGENT_API_KEYS=agent-id-1:replace-with-local-secret,agent-id-2:replace-with-local-secret
AGENT_API_KEYS=
